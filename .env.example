# ---- Nexusora Workforce API ----
NODE_ENV=development
PORT=5002
DEFAULT_LOCALE=en

# ---- MongoDB Atlas ----
# Master/registry DB (tenants, billing, platform admin)
MASTER_DB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/nexusora_wf_master?retryWrites=true&w=majority
# Base cluster URI; per-tenant DB name (nexusora_wf_<subdomain>) is swapped in at runtime
MONGO_CLUSTER_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net
TENANT_DB_PREFIX=nexusora_wf_

# ---- Auth ----
JWT_SECRET=change_me
JWT_EXPIRE=30d
PLATFORM_ADMIN_SECRET=change_me_separate_secret

# ---- Email (Brevo — port 2525, NOT 587) ----
# Transactional email is OPTIONAL. With no host set, the app runs fine and email
# is skipped (in-app notifications only). BREVO_SMTP_* are read as a fallback;
# generic SMTP_HOST/PORT/USER/PASS take precedence if you prefer another provider.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_USER=your_brevo_login@smtp-brevo.com
BREVO_SMTP_PASS=change_me
# Address every email is sent from (must be a verified sender on your provider).
MAIL_FROM=Nexusora Workforce <no-reply@nexusora.app>
# Public app URL used to build links in emails (login, reset, verify, surveys).
APP_URL=http://localhost:5173

# ---- Cloudinary (server-side only) ----
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# ---- Billing / subscriptions (A2) ----
# Trial + grace (days). Prices and tax are NOT set here — they are edited in the
# admin console and stored in the DB (multi-currency via FX).
TRIAL_DAYS=30
GRACE_DAYS=7
# Currency admins enter base prices in; other currencies are derived via FX.
PRICING_BASE_CURRENCY=GHS
# ---- Paystack (reuse the Nexusora Books account) ----
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx
# Currencies Paystack can charge for your account; others convert to the fallback.
PAYSTACK_CHARGE_CURRENCIES=GHS,NGN,USD,ZAR,KES
PAYSTACK_FALLBACK_CURRENCY=USD

# ---- CORS ----
CLIENT_URL=http://localhost:5173
